<+><?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\r\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\r\n    <modelVersion>4.0.0</modelVersion>\r\n    <parent>\r\n        <groupId>org.springframework.boot</groupId>\r\n        <artifactId>spring-boot-starter-parent</artifactId>\r\n        <version>3.5.6</version>\r\n        <relativePath/> <!-- lookup parent from repository -->\r\n    </parent>\r\n    <groupId>com.zjgsu.pjt</groupId>\r\n    <artifactId>catalog-service</artifactId>\r\n    <version>1.0.0</version>\r\n    <name>catalog-service</name>\r\n    <description>catalog Management Microservice</description>\r\n    <properties>\r\n        <maven.compiler.source>21</maven.compiler.source>\r\n        <maven.compiler.target>21</maven.compiler.target>\r\n        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>\r\n        <!-- 统一依赖版本，方便维护 -->\r\n        <lombok.version>1.18.32</lombok.version>\r\n        <springdoc.version>2.3.0</springdoc.version>\r\n    </properties>\r\n    <dependencies>\r\n        <!-- 核心Web依赖 -->\r\n        <dependency>\r\n            <groupId>org.springframework.boot</groupId>\r\n            <artifactId>spring-boot-starter-web</artifactId>\r\n        </dependency>\r\n\r\n        <!-- Spring Data JPA（数据库访问） -->\r\n        <dependency>\r\n            <groupId>org.springframework.boot</groupId>\r\n            <artifactId>spring-boot-starter-data-jpa</artifactId>\r\n        </dependency>\r\n\r\n        <!-- Lombok（简化实体类） -->\r\n        <dependency>\r\n            <groupId>org.projectlombok</groupId>\r\n            <artifactId>lombok</artifactId>\r\n            <version>${lombok.version}</version>\r\n            <optional>true</optional>\r\n        </dependency>\r\n\r\n        <!-- Jakarta Validation（参数校验：@NotBlank、@Min、@Valid等） -->\r\n        <dependency>\r\n            <groupId>org.springframework.boot</groupId>\r\n            <artifactId>spring-boot-starter-validation</artifactId>\r\n        </dependency>\r\n\r\n        <!-- SpringDoc OpenAPI 3（Swagger文档：@Tag、@Schema等） -->\r\n        <dependency>\r\n            <groupId>org.springdoc</groupId>\r\n            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>\r\n            <version>${springdoc.version}</version>\r\n        </dependency>\r\n\r\n        <!-- MySQL驱动（运行时依赖） -->\r\n        <dependency>\r\n            <groupId>com.mysql</groupId>\r\n            <artifactId>mysql-connector-j</artifactId>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n\r\n        <!-- H2内存数据库（测试用） -->\r\n        <dependency>\r\n            <groupId>com.h2database</groupId>\r\n            <artifactId>h2</artifactId>\r\n            <scope>runtime</scope>\r\n        </dependency>\r\n\r\n        <!-- 测试依赖 -->\r\n        <dependency>\r\n            <groupId>org.springframework.boot</groupId>\r\n            <artifactId>spring-boot-starter-test</artifactId>\r\n            <scope>test</scope>\r\n        </dependency>\r\n    </dependencies>\r\n\r\n    <build>\r\n        <finalName>catalog-service</finalName>\r\n        <plugins>\r\n            <!-- Spring Boot打包插件 -->\r\n            <plugin>\r\n                <groupId>org.springframework.boot</groupId>\r\n                <artifactId>spring-boot-maven-plugin</artifactId>\r\n                <configuration>\r\n                    <!-- 允许Lombok在打包时生效 -->\r\n                    <excludes>\r\n                        <exclude>\r\n                            <groupId>org.projectlombok</groupId>\r\n                            <artifactId>lombok</artifactId>\r\n                        </exclude>\r\n                    </excludes>\r\n                </configuration>\r\n            </plugin>\r\n\r\n            <!-- Maven编译器插件（配置Lombok注解处理器，关键！） -->\r\n            <plugin>\r\n                <groupId>org.apache.maven.plugins</groupId>\r\n                <artifactId>maven-compiler-plugin</artifactId>\r\n                <version>3.14.0</version>\r\n                <configuration>\r\n                    <source>${maven.compiler.source}</source>\r\n                    <target>${maven.compiler.target}</target>\r\n                    <encoding>${project.build.sourceEncoding}</encoding>\r\n                    <!-- 注解处理器路径：让Lombok注解被正确解析 -->\r\n                    <annotationProcessorPaths>\r\n                        <path>\r\n                            <groupId>org.projectlombok</groupId>\r\n                            <artifactId>lombok</artifactId>\r\n                            <version>${lombok.version}</version>\r\n                        </path>\r\n                        <!-- 校验注解处理器（可选，确保@NotBlank等生效） -->\r\n                        <path>\r\n                            <groupId>org.hibernate.validator</groupId>\r\n                            <artifactId>hibernate-validator-annotation-processor</artifactId>\r\n                            <version>8.0.1.Final</version>\r\n                        </path>\r\n                    </annotationProcessorPaths>\r\n                </configuration>\r\n            </plugin>\r\n        </plugins>\r\n    </build>\r\n</project>
